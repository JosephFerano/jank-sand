(ns fnm.p)
(defn t [label f]
  (println label (try (f) (catch :default e (str "THREW: " e)))))

(def grid2 (into [] (repeat 3 (into [] (repeat 3 0)))))
(t "nested get-in  " (fn [] (get-in grid2 [1 2])))
(t "nested assoc-in" (fn [] (get-in (assoc-in grid2 [1 2] 9) [1 2])))
(t "nth nested     " (fn [] (nth (nth grid2 1) 2)))
(t "vec of range   " (fn [] (count (vec (range 10)))))
(t "transient      " (fn [] (persistent! (assoc! (transient (vec (range 4))) 0 99))))
(t "into-array     " (fn [] (into-array [1 2 3])))
(t "make-array     " (fn [] (make-array 3)))
(t "rem            " (fn [] (rem 5 4)))
(t "mod            " (fn [] (mod 5 4)))
(t "quot           " (fn [] (quot 5 4)))
(t "int of double  " (fn [] (int 3.9)))
(t "bit-shift-right" (fn [] (bit-shift-right 0xE6B800 16)))
(t "bit-and        " (fn [] (bit-and 0xE6B800 0xFF)))
(t "nth w/ double  " (fn [] (nth [1 2 3] 1.0)))
